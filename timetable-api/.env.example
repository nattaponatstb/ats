# ── Database (Railway จะตั้งให้อัตโนมัติเมื่อ add PostgreSQL plugin) ──
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_secret_string_at_least_32_chars
JWT_EXPIRES_IN=8h

# ── Admin เริ่มต้น (ใช้ครั้งแรกที่ deploy เท่านั้น) ───────────────────
ADMIN_PASSWORD=admin1234

# ── CORS (optional) — URL ของ GitHub Pages ────────────────────────────
ALLOWED_ORIGINS=https://nattaponatstb.github.io
